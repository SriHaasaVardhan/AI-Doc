# AI Provider API Keys (at least one required; app tries OpenRouter → Groq → Google)
# OpenRouter: https://openrouter.ai/keys
# Groq: https://console.groq.com/keys
# Google Gemini: https://aistudio.google.com/apikey

OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GITHUB_TOKEN=

# Configuration (optional)
MAX_UPLOAD_SIZE_MB=50
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Optional model overrides
OPENROUTER_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-4-31b-it:free
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-2.0-flash
